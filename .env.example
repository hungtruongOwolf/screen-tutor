# Copy to .env and fill in. Never commit .env.

# Backend
NEBIUS_API_KEY=
TAVILY_API_KEY=
# fake = canned answer, no network. nebius = real model via Nebius Token Factory.
MODEL_ADAPTER=fake
# Optional overrides (for example a dedicated endpoint for an NVIDIA vision model):
# MODEL_NAME=google/gemma-3-27b-it
# MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1
# MODEL_API_KEY=
# Optional: require this token on every request to the backend
BACKEND_ACCESS_TOKEN=

# Desktop app
# Words that call the tutor by voice, comma separated (the first names it in hints). Pick words that are
# easy for you to say: open syllables such as Nova or Luna are easier than words ending in R.
# WAKE_WORD=nova,tutor
EXPLAIN_BACKEND_URL=http://127.0.0.1:8000

# Second model asked when the first is slow (empty = off), and how long to wait first
# MODEL_FALLBACK_NAME=Qwen/Qwen3.8-27B
# HEDGE_AFTER_SECONDS=4
# Limits (per process): requests per minute for the app and for the public playground
# RATE_LIMIT_PER_MINUTE=30
# PLAYGROUND_RATE_PER_MINUTE=8
# PLAYGROUND_ENABLED=1
# How much faster than normal the tutor talks, and which Piper voice (a voice that is not installed yet is downloaded at the next start).
# SPEECH_RATE=1.2
# Spoken rewrite of each step by an NVIDIA Nemotron model (backend: NARRATION_MODEL, empty = off; app: NARRATION=off)
# NARRATION_MODEL=nvidia/nemotron-3-super-120b-a12b
# PIPER_VOICE=en_US-lessac-medium
