{
  "name": "screen-tutor-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS infrastructure for screen-tutor: the backend as an arm64 (Graviton) Lambda container",
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "bootstrap": "cdk bootstrap",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy --force"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
